// Sistema academico de alocacao de salas, professores e materiais.
// Banco alvo: PostgreSQL.
//
// Decisoes de modelagem
// - Professores sao recursos e nao perfis de acesso. O vinculo com usuarios e
//   opcional para permitir docentes sem conta no sistema.
// - Competencias e recursos tecnicos sao catalogos normalizados com relacoes N:N.
// - Uma reserva agrega um ou mais itens. O item tem seu proprio intervalo para
//   permitir recursos com horarios distintos; o intervalo da reserva delimita
//   o periodo total e deve conter o intervalo de cada item.
// - Cada item referencia exatamente uma sala, um professor ou um material por
//   meio de chaves estrangeiras concretas. Isso preserva integridade referencial
//   e evita o par polimorfico tipo_recurso/recurso_id sem FK verificavel.
// - A reserva guarda o estado agregado; o item guarda seu estado individual,
//   necessario para aprovacoes por item e para as garantias de concorrencia.
//   Transacoes devem manter os estados coerentes.
// - Reservas de material podem se sobrepor se a soma das quantidades nao exceder
//   o estoque. Salas e professores sao recursos exclusivos no intervalo.
// - Aprovacoes sao eventos por item e tipo de decisao. A justificativa e
//   obrigatoria em qualquer decisao e o historico deve ser append-only.
// - Retiradas e devolucoes sao eventos separados por item. Devolucao pendente e
//   calculada pela diferenca entre quantidades retiradas e devolvidas.
// - Usuarios, salas, professores e materiais usam ativo para desativacao sem
//   apagar referencias historicas.
// - O escopo dos Responsaveis e definido pela tabela escopos_responsavel (RN09).
//   Um Responsavel decide apenas itens cujo recurso esteja no seu escopo.
//
// Garantias a completar na migracao PostgreSQL (DBML nao expressa todas):
// 1. CHECKs para inicio < fim e item contido no intervalo geral da reserva.
// 2. CREATE EXTENSION btree_gist e EXCLUDE USING gist, separadamente para sala
//    e professor, comparando o id do recurso e tstzrange(inicio, fim, '[)')
//    com &&. Aplicar somente a itens APROVADA/CONFIRMADA.
// 3. Para materiais, trigger/transacao que bloqueie a linha de materiais com
//    SELECT ... FOR UPDATE e valide a disponibilidade de estoque para o
//    intervalo, incluindo itens APROVADA/CONFIRMADA sobrepostos e unidades
//    retiradas que ainda nao foram devolvidas. Recusar excesso.
// 4. Validar em transacao que recurso_id corresponda ao recurso do item em
//    aprovacoes e retiradas_devolucoes, que o responsavel tenha perfil
//    RESPONSAVEL e que o recurso do item esteja em escopos_responsavel desse
//    responsavel (RN09), e que movimentos de devolucao nao excedam retiradas.
// 5. Conceder a aplicacao INSERT, mas nao UPDATE/DELETE, em auditoria e
//    aprovacoes; reforcar append-only tambem com privilegios/triggers.
// 6. Bloqueios ativos devem impedir novas alocacoes. A politica para bloqueios
//    criados sobre reservas ja aprovadas/confirmadas precisa ser definida.
// 7. Validar que toda reserva tenha ao menos um item e que cada item pertença
//    ao intervalo geral da reserva.

Enum perfil_usuario {
  ADMIN
  RESPONSAVEL
  SOLICITANTE
}

Enum status_reserva {
  PENDENTE
  APROVADA
  CONFIRMADA
  CANCELADA
  REJEITADA
}

Enum status_reserva_item {
  PENDENTE
  APROVADA
  CONFIRMADA
  CANCELADA
  REJEITADA
}

Enum tipo_decisao {
  RECURSO_RESTRITO
  VALIDACAO_DOCENTE
}

Enum decisao_aprovacao {
  APROVADA
  REJEITADA
}

Enum tipo_bloqueio {
  BLOQUEIO
  MANUTENCAO
}

Enum status_bloqueio {
  ATIVO
  CANCELADO
  CONCLUIDO
}

Enum tipo_movimentacao_material {
  RETIRADA
  DEVOLUCAO
}

Enum status_notificacao {
  PENDENTE
  ENVIADA
  LIDA
  FALHOU
}

Table usuarios {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  nome varchar(200) [not null]
  email varchar(320) [not null, unique]
  senha_hash text [not null, note: 'Armazenar somente hash seguro; nunca senha em texto puro.']
  perfil perfil_usuario [not null]
  ativo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Conta autenticada e perfil de autorizacao. Recomenda-se unicidade de email sem diferenciar maiusculas/minusculas no PostgreSQL.'
}

Table salas {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  nome varchar(160) [not null]
  tipo varchar(80) [not null, note: 'Categoria institucional, por exemplo sala de aula ou laboratorio.']
  capacidade integer [not null]
  localizacao varchar(240) [not null]
  restrita boolean [not null, default: false]
  ativa boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `capacidade` > 0
  }

  indexes {
    (tipo, capacidade)
    (localizacao)
    (ativa, restrita)
  }
}

Table recursos_tecnicos {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  nome varchar(120) [not null, unique]
  descricao text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sala_recursos_tecnicos {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  sala_id uuid [not null]
  recurso_tecnico_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (sala_id, recurso_tecnico_id) [unique]
    (recurso_tecnico_id)
  }
}

Table professores {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  usuario_id uuid [unique, note: 'Opcional: a conta de acesso pode nao corresponder a um docente.']
  nome varchar(200) [not null]
  email varchar(320) [unique]
  ativo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (ativo, nome)
  }
}

Table competencias {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  nome varchar(160) [not null, unique]
  descricao text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table professor_competencias {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  professor_id uuid [not null]
  competencia_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (professor_id, competencia_id) [unique]
    (competencia_id)
  }
}

Table materiais {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  nome varchar(200) [not null]
  tipo varchar(100) [not null]
  quantidade_total integer [not null]
  restrito boolean [not null, default: false]
  ativo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `quantidade_total` >= 0
  }

  indexes {
    (tipo, ativo)
    (nome)
  }

  Note: 'Estoque compartilhado: reservas simultaneas sao permitidas ate o limite de quantidade, nao uma exclusao total por cadastro.'
}

Table reservas {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  solicitante_id uuid [not null]
  inicio timestamptz [not null]
  fim timestamptz [not null]
  status status_reserva [not null, default: 'PENDENTE']
  versao integer [not null, default: 1]
  finalidade text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `inicio` < `fim`
    `versao` > 0
  }

  indexes {
    (solicitante_id, created_at)
    (status, inicio, fim)
  }

  Note: 'versao e incrementada a cada alteracao para controle otimista. O intervalo geral deve conter os intervalos dos itens.'
}

Table reserva_itens {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  reserva_id uuid [not null]
  sala_id uuid
  professor_id uuid
  material_id uuid
  inicio timestamptz [not null]
  fim timestamptz [not null]
  quantidade integer [not null, default: 1]
  status status_reserva_item [not null, default: 'PENDENTE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `inicio` < `fim`
    num_nonnulls(`sala_id`, `professor_id`, `material_id`) = 1
    (`material_id` IS NOT NULL AND `quantidade` > 0) OR (`material_id` IS NULL AND `quantidade` = 1)
  }

  indexes {
    (reserva_id)
    (sala_id, status, inicio, fim)
    (professor_id, status, inicio, fim)
    (material_id, status, inicio, fim)
  }

  Note: 'Exatamente uma entre sala_id, professor_id e material_id deve ser preenchida. Para sala/professor, quantidade deve ser 1. Itens ativos sao APROVADA ou CONFIRMADA.'
}

Table aprovacoes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  reserva_item_id uuid [not null]
  responsavel_id uuid [not null]
  tipo tipo_decisao [not null]
  decisao decisao_aprovacao [not null]
  justificativa text [not null]
  decidido_em timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  checks {
    length(trim(`justificativa`)) > 0
  }

  indexes {
    (reserva_item_id, tipo, decidido_em)
    (responsavel_id, decidido_em)
  }

  Note: 'Append-only: uma linha por decisao. A reserva e obtida via reserva_itens para evitar duplicar reserva_id.'
}

Table bloqueios {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  sala_id uuid
  professor_id uuid
  material_id uuid
  tipo tipo_bloqueio [not null]
  inicio timestamptz [not null]
  fim timestamptz [not null]
  motivo text [not null]
  status status_bloqueio [not null, default: 'ATIVO']
  criado_por uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `inicio` < `fim`
    num_nonnulls(`sala_id`, `professor_id`, `material_id`) = 1
  }

  indexes {
    (sala_id, status, inicio, fim)
    (professor_id, status, inicio, fim)
    (material_id, status, inicio, fim)
  }

  Note: 'Exatamente uma entre sala_id, professor_id e material_id deve ser preenchida. Bloqueios ativos impedem novas alocacoes no intervalo.'
}

Table retiradas_devolucoes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  reserva_item_id uuid [not null]
  responsavel_id uuid [not null]
  tipo tipo_movimentacao_material [not null]
  quantidade integer [not null]
  ocorrido_em timestamptz [not null, default: `now()`]
  observacao text
  created_at timestamptz [not null, default: `now()`]

  checks {
    `quantidade` > 0
  }

  indexes {
    (reserva_item_id, ocorrido_em)
    (responsavel_id, ocorrido_em)
  }

  Note: 'Eventos append-only de retirada/devolucao, ligados somente a itens de material. O saldo pendente e a soma das retiradas menos devolucoes.'
}

Table auditoria {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  usuario_id uuid [note: 'Nulo para eventos automatizados; a origem deve ser identificada em valor_novo ou metadados.']
  origem varchar(20) [not null, default: 'USUARIO', note: 'Identifica se o evento foi iniciado por usuario ou processo de sistema.']
  entidade varchar(100) [not null]
  entidade_id uuid [not null]
  acao varchar(40) [not null, note: 'Ex.: CRIACAO, ALTERACAO, CANCELAMENTO, APROVACAO, BLOQUEIO, CONFLITO_EVITADO.']
  valor_anterior jsonb
  valor_novo jsonb
  ocorrido_em timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entidade, entidade_id, ocorrido_em)
    (usuario_id, ocorrido_em)
  }

  Note: 'Log append-only. Tentativas recusadas por conflito usam acao CONFLITO_EVITADO, com entidade igual ao tipo do recurso disputado (salas, professores ou materiais), entidade_id igual ao id do recurso e, em valor_novo, o intervalo pedido e o motivo (SOBREPOSICAO, BLOQUEIO, ESTOQUE ou CONCORRENCIA). entidade_id e polimorfico e intencionalmente nao possui FK. Restringir UPDATE/DELETE tambem no banco.'
}

Table notificacoes {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  usuario_id uuid [not null]
  reserva_id uuid
  assunto varchar(200) [not null]
  mensagem text [not null]
  status status_notificacao [not null, default: 'PENDENTE']
  data timestamptz [not null, default: `now()`]
  enviada_em timestamptz
  lida_em timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, status, data)
    (reserva_id, data)
  }

  Note: 'Registro interno de notificacoes simuladas, sem dependencia de provedor externo.'
}

Table escopos_responsavel {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  responsavel_id uuid [not null]
  sala_id uuid
  professor_id uuid
  material_id uuid
  created_at timestamptz [not null, default: `now()`]

  checks {
    num_nonnulls(`sala_id`, `professor_id`, `material_id`) = 1
  }

  indexes {
    (responsavel_id, sala_id) [unique]
    (responsavel_id, professor_id) [unique]
    (responsavel_id, material_id) [unique]
  }

  Note: 'Recursos que o Responsavel pode decidir (RN09). Exatamente uma entre sala_id, professor_id e material_id deve ser preenchida. O PostgreSQL trata NULL como distinto em indices unicos, entao cada indice impede duplicidade apenas do tipo de recurso correspondente.'
}

Ref: sala_recursos_tecnicos.sala_id > salas.id [delete: cascade]
Ref: sala_recursos_tecnicos.recurso_tecnico_id > recursos_tecnicos.id [delete: restrict]

Ref: professores.usuario_id > usuarios.id [delete: restrict]
Ref: professor_competencias.professor_id > professores.id [delete: cascade]
Ref: professor_competencias.competencia_id > competencias.id [delete: restrict]

Ref: reservas.solicitante_id > usuarios.id [delete: restrict]

Ref: reserva_itens.reserva_id > reservas.id [delete: restrict]
Ref: reserva_itens.sala_id > salas.id [delete: restrict]
Ref: reserva_itens.professor_id > professores.id [delete: restrict]
Ref: reserva_itens.material_id > materiais.id [delete: restrict]

Ref: aprovacoes.reserva_item_id > reserva_itens.id [delete: restrict]
Ref: aprovacoes.responsavel_id > usuarios.id [delete: restrict]

Ref: bloqueios.sala_id > salas.id [delete: restrict]
Ref: bloqueios.professor_id > professores.id [delete: restrict]
Ref: bloqueios.material_id > materiais.id [delete: restrict]
Ref: bloqueios.criado_por > usuarios.id [delete: restrict]

Ref: retiradas_devolucoes.reserva_item_id > reserva_itens.id [delete: restrict]
Ref: retiradas_devolucoes.responsavel_id > usuarios.id [delete: restrict]

Ref: auditoria.usuario_id > usuarios.id [delete: restrict]

Ref: notificacoes.usuario_id > usuarios.id [delete: restrict]
Ref: notificacoes.reserva_id > reservas.id [delete: restrict]

Ref: escopos_responsavel.responsavel_id > usuarios.id [delete: cascade]
Ref: escopos_responsavel.sala_id > salas.id [delete: restrict]
Ref: escopos_responsavel.professor_id > professores.id [delete: restrict]
Ref: escopos_responsavel.material_id > materiais.id [delete: restrict]
