// Esquema físico conforme app/models.py e migrations/*.sql.
// Fonte de verdade: modelos SQLAlchemy e migrações executadas por app/db.py.
// O DBML descreve tabelas, colunas e chaves; garantias PostgreSQL específicas
// estão anotadas abaixo porque DBML não representa todas as constraints.

Project alocasenac {
  database_type: 'PostgreSQL'
  Note: 'Esquema físico da aplicação. Tipos Resource são diferenciados por resource_type.'
}

Table users {
  id varchar [pk, not null]
  name varchar [not null]
  email varchar [not null, unique]
  password_hash varchar [not null]
  role varchar [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table resources {
  id varchar [pk, not null]
  resource_type varchar [not null, note: 'sala, professor ou material']
  name varchar [not null]
  category varchar
  capacity integer
  location varchar
  competencies json
  quantity_total integer
  restricted boolean [not null, default: false]
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table resource_scopes {
  id varchar [pk, not null]
  responsible_id varchar [not null]
  resource_id varchar [not null]
  created_at timestamptz [not null]

  Indexes {
    (responsible_id, resource_id) [unique, name: 'uq_responsible_resource_scope']
  }
}

Table resource_blocks {
  id varchar [pk, not null]
  resource_id varchar [not null]
  start timestamptz [not null]
  end timestamptz [not null]
  reason varchar [not null]
  status varchar [not null, default: 'ATIVO']
  created_by varchar
  created_at timestamptz [not null]

  checks {
    `start` < `end`
  }
}

Table reservations {
  id varchar [pk, not null]
  solicitante_id varchar [not null]
  reason varchar [not null]
  status varchar [not null, default: 'PENDENTE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table reservation_items {
  id varchar [pk, not null]
  reservation_id varchar [not null]
  resource_type varchar [not null]
  resource_id varchar [not null, note: 'Identificador polimórfico; não possui FK para resources.']
  start timestamptz [not null]
  end timestamptz [not null]
  quantity integer [not null, default: 1]
  status varchar [not null, default: 'PENDENTE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `start` < `end`
    `quantity` > 0
  }
}

Table approvals {
  id varchar [pk, not null]
  reservation_item_id varchar [not null]
  responsible_id varchar [not null]
  decision_type varchar [not null]
  decision varchar [not null]
  justification varchar [not null]
  decided_at timestamptz [not null]
  created_at timestamptz [not null]
}

Table material_movements {
  id varchar [pk, not null]
  reservation_item_id varchar [not null]
  responsible_id varchar [not null]
  movement_type varchar [not null]
  quantity integer [not null]
  occurred_at timestamptz [not null]
  observation varchar

  checks {
    `movement_type` IN ('RETIRADA', 'DEVOLUCAO')
    `quantity` > 0
  }
}

Table notifications {
  id varchar [pk, not null]
  user_id varchar [not null]
  reservation_id varchar [not null]
  event varchar [not null]
  subject varchar [not null]
  message varchar [not null]
  status varchar [not null, default: 'ENVIADA']
  created_at timestamptz [not null]
}

Table audit_entries {
  id varchar [pk, not null]
  entity_type varchar [not null]
  entity_id varchar [not null, note: 'Identificador polimórfico do recurso ou entidade auditada.']
  action varchar [not null]
  payload varchar [not null]
  actor_id varchar
  before_value varchar
  after_value varchar
  created_at timestamptz [not null]
}

Ref: resource_scopes.responsible_id > users.id
Ref: resource_scopes.resource_id > resources.id
Ref: resource_blocks.resource_id > resources.id
Ref: resource_blocks.created_by > users.id
Ref: reservation_items.reservation_id > reservations.id
Ref: approvals.reservation_item_id > reservation_items.id
Ref: approvals.responsible_id > users.id
Ref: material_movements.reservation_item_id > reservation_items.id
Ref: material_movements.responsible_id > users.id
Ref: notifications.user_id > users.id
Ref: notifications.reservation_id > reservations.id

// Garantias implementadas nas migrações e serviços:
// - 002_exclusao_sobreposicao.sql ativa btree_gist e EXCLUDE USING gist para
//   reservation_items em APROVADA, CONFIRMADA e EM_USO, exceto material.
// - ReservationService bloqueia a linha de resources com SELECT FOR UPDATE
//   para material e valida a soma das quantidades contra quantity_total.
// - 003_auditoria_imutavel.sql impede UPDATE e DELETE em audit_entries, approvals
//   e material_movements por triggers.
// - Os índices criados em SQL e as colunas de auditoria podem diferir de uma
//   representação DBML; consultar models.py e migrations/*.sql para detalhes.
